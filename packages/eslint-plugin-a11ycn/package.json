{
  "name": "eslint-plugin-a11ycn",
  "version": "0.1.0",
  "private": true,
  "description": "ESLint rules for WCAG 2.2 issues in React, Next.js, Tailwind, and shadcn/ui.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.46.2",
    "@typescript-eslint/types": "^8.46.2",
    "eslint": "^9.39.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
